# NHCX Payer MCP — Environment Configuration
# Copy this file to .env and fill in your values.

# --- Required: ABDM Gateway Credentials ---
# Get these from NHA for your environment (sandbox, staging, production).
NDHM_CLIENT_ID=SBX_000676
NDHM_CLIENT_SECRET=your-sandbox-secret-here

# --- Auth URL ---
# Defaults to the ABDM dev gateway. Override if your environment differs.
# NDHM_URL=https://dev.abdm.gov.in

# --- Environment ---
# sandbox (default) | staging | production
# NHCX_ENV=sandbox

# --- Payer Configuration ---
# Your payer code (sandbox default: 1518)
# PAYER_ID=1518

# --- Provider / Sender Configuration ---
# Default provider/sender code for testing
# SENDER_CODE=1000000001

# --- Patient Configuration ---
# Default patient ABHA/PMJAY member ID for testing
# MEMBER_ID=your-test-member-id

# --- Advanced ---
# API request timeout in milliseconds (default: 30000)
# NHCX_TIMEOUT=30000

# Number of automatic retries on transient errors (5xx, network) — default 0
# NHCX_RETRIES=0

# Enable debug logging to stderr
# DEBUG=true

# --- API URL Overrides ---
# Use these to point at custom endpoints instead of the NHCX_ENV defaults.
# NHCX_USER_ROLE_URL=https://apisbx.abdm.gov.in/pmjay/sbxhcx/nhcxpayerservice/v1
# NHCX_PROCESS_CASE_URL=https://apisbeta.nha.gov.in/pmjay/hcx/nhcxpayerservice/wrapper
