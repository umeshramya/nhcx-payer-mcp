# NHCX Payer MCP — Environment Configuration
# Copy this file to .env and fill in your values.

# --- Required: ABDM Gateway Credentials ---
# Get these from NHA for your environment (sandbox, staging, production).
NDHM_CLIENT_ID=SBX_000XXX
NDHM_CLIENT_SECRET=your-sandbox-secret-here

# --- Auth URL ---
# Defaults to the ABDM dev gateway. Override if your environment differs.
# NDHM_URL=https://dev.abdm.gov.in

# --- Environment ---
# Selects the API host set: sandbox (default) | staging | production.
# An unknown value falls back to sandbox; the URL overrides below always win.
# NHCX_ENV=sandbox

# --- Payer Configuration ---
# Your payer code (sandbox default: 1518)
# PAYER_ID=1518

# --- Provider / Sender Configuration ---
# Default provider/sender code for testing
# SENDER_CODE=1000000001

# --- Patient Configuration ---
# Default patient ABHA/PMJAY member ID for testing
# MEMBER_ID=your-test-member-id

# --- PMJAY Payment Flow (nhcx_get_payment_details / nhcx_update_payment) ---
# UTR / transaction reference sent in the payment update (default: SAYAN12345)
# PAYMENT_UTR=SAYAN12345

# Payer-portal identity headers for the payment-update endpoint.
# It is authenticated by these headers, NOT by a bearer token.
# PAYER_PORTAL_UID=USER4007
# PAYER_PORTAL_UNAME=Shubham
# PAYER_PORTAL_UROLE=System
# PAYER_PORTAL_USTATE=112
# PAYER_PORTAL_SOURCE=internal
# PAYER_PORTAL_HID=0
# PAYER_PORTAL_CID=0

# --- Advanced ---
# API request timeout in milliseconds (default: 30000)
# NHCX_TIMEOUT=30000

# Number of automatic retries on transient errors (5xx, network) — default 0
# NHCX_RETRIES=0

# Enable debug logging to stderr
# DEBUG=true

# --- API URL Overrides ---
# Use these to point at custom endpoints instead of the NHCX_ENV defaults.
# NHCX_USER_ROLE_URL=https://apisbx.abdm.gov.in/pmjay/sbxhcx/nhcxpayerservice/v1
# NHCX_PROCESS_CASE_URL=https://apisbeta.nha.gov.in/pmjay/hcx/nhcxpayerservice/wrapper
# NHCX_UPDATE_ABHA_URL=https://apisbx.abdm.gov.in/pmjay/sbxhcx/participanthcxservice
# NHCX_PAYMENT_DETAILS_URL=https://apisbx.abdm.gov.in/pmjay/sbxhcx/nhcxpayerservice/v1
# NHCX_PAYMENT_UPDATE_URL=https://apisbeta.nha.gov.in/pmjay/payer/paypayment/v1
